{
    "name": "goletter/hyperf-cache",
    "description": "Laravel-style cache repository for Hyperf.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "php",
        "hyperf",
        "cache",
        "lock"
    ],
    "authors": [
        {
            "name": "goletter",
            "email": "goletter@outlook.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "hyperf/cache": "~3.1.0 || ~3.2.0",
        "hyperf/collection": "~3.1.0 || ~3.2.0",
        "hyperf/context": "~3.1.0 || ~3.2.0",
        "hyperf/macroable": "~3.1.0 || ~3.2.0",
        "hyperf/support": "~3.1.0 || ~3.2.0",
        "hyperf/tappable": "~3.1.0 || ~3.2.0",
        "nesbot/carbon": "^2.0 || ^3.0"
    },
    "require-dev": {
        "hyperf/redis": "~3.1.0 || ~3.2.0",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "suggest": {
        "hyperf/redis": "Required for distributed locks, remember() stampede protection, and flexible() mutual exclusion (~3.1.0 || ~3.2.0).",
        "hyperf/coroutine": "Required to defer stale-while-revalidate refresh and coroutine-friendly lock waits (~3.1.0 || ~3.2.0).",
        "friendsofhyperf/lock": "Optional fallback lock for flexible() when hyperf/redis is unavailable (~3.1.0 || ~3.2.0)."
    },
    "autoload": {
        "psr-4": {
            "Goletter\\Cache\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Goletter\\Cache\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml --colors=always"
    },
    "extra": {
        "hyperf": {
            "config": "Goletter\\Cache\\ConfigProvider"
        }
    },
    "config": {
        "sort-packages": true
    }
}
